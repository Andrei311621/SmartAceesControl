#include <ESP8266WiFi.h>
#include <FirebaseESP8266.h>
#include <SoftwareSerial.h>

#define FIREBASE_HOST "licenta-5c37a-default-rtdb.firebaseio.com"
#define FIREBASE_AUTH "AIzaSyDGf5S_TrGC9dEty2WFyTteLjA-IX-pQxc"
#define WIFI_SSID "AndreiC"
#define WIFI_PASSWORD "andrei21"

#define espSerial Serial

FirebaseData firebaseData;
FirebaseAuth auth;
FirebaseConfig config;

void setup() {
  Serial.begin(9600);  
  espSerial.begin(9600); 

  
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("Connecting to WiFi...");
    espSerial.println("Connecting to WiFi...");
  }
  Serial.println("Connected to WiFi");
  espSerial.println("Connected to WiFi");

  config.host = FIREBASE_HOST;
  config.signer.tokens.legacy_token = FIREBASE_AUTH;
  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);

  Serial.println("Firebase setup completed");
}

void loop() { 
  if (Firebase.getString(firebaseData, "/alarm/status")) {
    String alarmStatus = firebaseData.stringData();
    if (alarmStatus == "false") {
      Serial.println("Alarm should be disabled.");
      espSerial.println("DISABLE_ALARM");

      Firebase.setString(firebaseData, "/alarm/status", "hold");
    }
  } else {
    Serial.println("Failed to get data from Firebase.");
    Serial.println(firebaseData.errorReason());
  }

  if (Firebase.getString(firebaseData, "/fingerprint/request")) {
    String requestStatus = firebaseData.stringData();
    if (requestStatus == "true") {
      Serial.println("Fingerprint list requested.");
      espSerial.println("LIST_FINGERPRINTS");  
      
      Firebase.setString(firebaseData, "/fingerprint/request", "false");
    }
  } else {
    Serial.println("Failed to get data from Firebase.");
    Serial.println(firebaseData.errorReason());
  }

  if (Firebase.getString(firebaseData, "/delete_fingerprint_id")) {
    String fingerprintID = firebaseData.stringData();

fingerprintID.replace("\"", "");
    fingerprintID.replace("\\", "");
    

    if (fingerprintID.length() > 0) {
      espSerial.print("DELETE:");
      espSerial.println(fingerprintID);

      Firebase.setString(firebaseData, "/delete_fingerprint_id", "");
      delay(1000);
    }
  } else {
    delay(500);
    Serial.println("Failed to get data from Firebase.");
    Serial.println(firebaseData.errorReason());
  }

  if (Firebase.getString(firebaseData, "/add_fingerprint")) {
    String fingerprintData = firebaseData.stringData();
    fingerprintData.replace("\"", "");
    fingerprintData.replace("\\", "");

    if (fingerprintData.length() > 0) {
      espSerial.print("ADD:");
      espSerial.println(fingerprintData);

      Firebase.setString(firebaseData, "/add_fingerprint", "");
      delay(1000);
    }
  }

  if (espSerial.available()) {
    String command = espSerial.readStringUntil('\n'); 
    command.trim();

    if (command == "DISABLE_ALARM") {
      Firebase.setString(firebaseData, "/alarm/status", "false");
      Serial.println("Alarm disabled and status updated in Firebase.");
    } else if (command == "ACTIVATE_ALARM") {
      Firebase.setString(firebaseData, "/alarm/status", "true");
      Serial.println("Alarm activated and status updated in Firebase.");
    } 

  delay(500); 
}}

